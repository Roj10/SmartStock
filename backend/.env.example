# Copie este arquivo para "backend/.env" e coloque a senha do banco do Supabase.
# O arquivo .env é ignorado pelo git: a senha nunca vai para o GitHub.
# (Supabase > Project Settings > Database > Database password)
# Escreva a senha sem aspas. Evite acentos; se ela tiver uma barra invertida (\), escreva duas (\\).
SUPABASE_DB_PASSWORD=coloque-a-senha-do-banco-aqui

# Segredo do servidor: assina os logins (tokens) e cifra os segredos do 2FA guardados no banco.
# Use pelo menos 32 caracteres aleatórios. Para gerar um no PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RNGCryptoServiceProvider]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Se ele mudar, todos precisam entrar de novo e configurar o 2FA de novo.
SMARTSTOCK_SECRET=coloque-um-segredo-aleatorio-de-pelo-menos-32-caracteres

# Chave secreta do projeto, usada para guardar fotos e arquivos no Supabase Storage.
# (Supabase > Project Settings > API Keys > Secret keys; começa com "sb_secret_")
# Nunca coloque essa chave no frontend nem no GitHub: ela dá acesso total ao projeto.
SUPABASE_SERVICE_KEY=coloque-a-chave-secreta-aqui
